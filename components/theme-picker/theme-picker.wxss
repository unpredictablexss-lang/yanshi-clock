.themes {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.theme-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(201, 192, 176, 0.55);
  background: rgba(255, 255, 255, 0.35);
  position: relative;
  box-sizing: border-box;
}

.theme-card.active {
  border-color: var(--yskc-accent);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  background: var(--yskc-card);
}

.swatch {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.swatch-accent {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 28rpx;
}

.swatch-decor {
  position: absolute;
  right: 0;
  top: 0;
  width: 28rpx;
  height: 100%;
  opacity: 0.85;
}

.swatch-gold {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.55);
}

.meta {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.tagline {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--yskc-muted);
  letter-spacing: 1rpx;
}

.badge {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.4;
}

.theme-songyun.active { border-radius: 8rpx; }
.theme-tangfeng.active { border-color: #B83228; }
.theme-guochao.active { border-radius: 4rpx; border-width: 3rpx; }
.theme-wenfang.active { border-left-width: 8rpx; }
