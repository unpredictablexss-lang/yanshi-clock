.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  background: var(--yskc-bg);
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.hint { color: var(--yskc-muted); font-size: 26rpx; }

.save {
  margin: 0;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.4;
  background: linear-gradient(180deg, #C4A574 0%, #8B6914 100%);
  color: #FBF7EF;
  border-radius: 10rpx;
}
.save::after { border: none; }

.picker-card {
  background: var(--yskc-card);
  border: 1rpx solid var(--yskc-border);
  border-radius: 14rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.picker {
  height: 220rpx;
}

.pv {
  line-height: 70rpx;
  text-align: center;
  font-size: 30rpx;
}

.duration {
  margin: 24rpx 8rpx;
  color: var(--yskc-accent);
  font-size: 28rpx;
  position: relative;
  z-index: 1;
}

.task-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 24rpx;
  background: var(--yskc-card);
  border: 1rpx solid var(--yskc-border);
  border-radius: 14rpx;
  position: relative;
  z-index: 1;
}

.task-input {
  flex: 1;
  height: 72rpx;
  font-size: 30rpx;
  color: var(--yskc-text);
}

.task-ph {
  color: var(--yskc-muted);
}

.task-count {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--yskc-muted);
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}
